(version 1)
# =====================================================================
# JLCPCB Fertigungsregeln - 4-Lagen, 1 oz aussen / 0.5 oz innen, FR4
# Quelle: https://jlcpcb.com/capabilities/pcb-capabilities
# Es sind die Fertigungsminima ohne Aufpreis hinterlegt.
# Die Netzklassen (Default/Power) bleiben massgeblich, solange sie
# groesser sind - diese Regeln fangen nur Unterschreitungen ab.
# =====================================================================

# ---------- Leiterbahnen ----------
(rule "JLC: Bahnbreite"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.09mm)))

(rule "JLC: Abstand Bahn-Bahn"
	(condition "A.Type == 'Track' && B.Type == 'Track'")
	(constraint clearance (min 0.09mm)))

(rule "JLC: Abstand Pad-Bahn"
	(condition "A.Type == 'Pad' && B.Type == 'Track'")
	(constraint clearance (min 0.1mm)))

(rule "JLC: Abstand SMD-Pad zu SMD-Pad (fremdes Netz)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net")
	(constraint clearance (min 0.127mm)))

# ---------- Leiterplattenrand ----------
(rule "JLC: Kupfer zum Platinenrand (gefraest)"
	(constraint edge_clearance (min 0.3mm)))

# ---------- Bohrungen allgemein ----------
(rule "JLC: Bohrdurchmesser"
	(constraint hole_size (min 0.15mm) (max 6.3mm)))

(rule "JLC: NPTH-Bohrung"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

(rule "JLC: PTH-Bohrung"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_size (min 0.2mm)))

# ---------- Vias ----------
(rule "JLC: Via Bohrung"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.15mm)))

(rule "JLC: Via Durchmesser"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.25mm)))

(rule "JLC: Via Restring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.05mm)))

# ---------- Restring PTH-Pads ----------
(rule "JLC: PTH Restring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.13mm)))

# ---------- Bohrung zu Kupfer / Bohrung zu Bohrung ----------
(rule "JLC: Via-Bohrung zu Bahn"
	(condition "A.Type == 'Via' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.2mm)))

(rule "JLC: PTH-Bohrung zu Bahn"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC: NPTH-Bohrung zu Kupfer"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.25mm)))

(rule "JLC: Bohrung zu Bohrung (gleiches Netz)"
	(condition "A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm)))

(rule "JLC: Bohrung zu Bohrung (fremdes Netz)"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm)))

(rule "JLC: Abstand Pad mit Bohrung zu Pad mit Bohrung (fremdes Netz)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole' && A.Net != B.Net")
	(constraint clearance (min 0.5mm)))

# ---------- Bestueckungsdruck ----------
(rule "JLC: Silkscreen Text"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1.0mm)))

(rule "JLC: Silkscreen zu Pad / Loetstoppoeffnung"
	(layer "?.Silkscreen")
	(constraint silk_clearance (min 0.15mm)))
